[Unit]
Description=TotalSeg Agent Web and A2A
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
# Adjust these paths to your checkout before installing the unit.
WorkingDirectory=%h/MedSegAgent
EnvironmentFile=%h/MedSegAgent/.env
ExecStart=%h/.local/bin/uv run --frozen --no-sync medsegagent serve --host 127.0.0.1 --port 8767
Restart=on-failure
RestartSec=5
TimeoutStopSec=40
# TERM uv first; it forwards to Python so lifespan records restart before stopping inference.
# Remaining processes still receive KILL after the main process exits or TimeoutStopSec.
KillMode=mixed
UMask=0077
NoNewPrivileges=true
PrivateTmp=true
LimitNOFILE=4096
MemoryMax=28G
# Three model processes include bounded native-library and data-loader threads.
TasksMax=768
CPUQuota=800%

[Install]
WantedBy=default.target
