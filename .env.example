OPENAI_BASE_URL=https://api.deepseek.com/v1
OPENAI_API_KEY=
OPENAI_MODEL=deepseek-v4-flash
MEDSEGAGENT_PUBLIC_URL=http://127.0.0.1:8767
MEDSEGAGENT_DATA_ROOT=runtime
# Guest access and anonymous A2A work without GitHub configuration.
# Optional GitHub OAuth: set both values or leave both empty.
# Callback: MEDSEGAGENT_PUBLIC_URL + /api/auth/github/callback
# Uses only the public profile; no repository or email scopes are requested.
MEDSEGAGENT_GITHUB_CLIENT_ID=
MEDSEGAGENT_GITHUB_CLIENT_SECRET=
MEDSEGAGENT_RETENTION_HOURS=24
MEDSEGAGENT_TIMEOUT_SECONDS=7200
MEDSEGAGENT_MAX_MODEL_REQUESTS=24
MEDSEGAGENT_MAX_TOOL_CALLS=64
# Upstream single-image preprocessing/export; set cli to use the original CLI worker path.
MEDSEGAGENT_TOTALSEG_ENGINE=sequential
# macOS: mps (one inference at a time). On NVIDIA Linux change this to gpu.
MEDSEGAGENT_DEVICE=mps
# Leave MEDSEGAGENT_GPU_IDS and CUDA_VISIBLE_DEVICES unset to assess all NVIDIA GPUs.
# Optional operator restriction: physical indices or full GPU UUIDs, not child-local indices.
# An explicit MEDSEGAGENT_GPU_IDS overrides an inherited CUDA_VISIBLE_DEVICES.
# MEDSEGAGENT_GPU_IDS=0,1
MEDSEGAGENT_MAX_CONCURRENT_INFERENCES=3
MEDSEGAGENT_GPU_MIN_FREE_MIB=8192
MEDSEGAGENT_GPU_MAX_UTILIZATION=20
# All MedSegAgent processes on a host must share the scheduler lock directory.
# Default: ~/.cache/medsegagent/scheduler
# MEDSEGAGENT_SCHEDULER_LOCK_DIR=/absolute/private/shared-scheduler-directory
# Create a private temporary directory before setting TMPDIR.
# Keep NIfTI temporary expansion on the bulk data disk, outside Git.
# TMPDIR=/absolute/private/runtime/tmp
